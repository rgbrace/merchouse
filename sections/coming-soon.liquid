{%- comment -%}
  Merchouse · Coming soon (login-style)
  The sign-in card is a placeholder: nothing is submitted or stored.
  "Get launch updates" saves an email to Shopify customers (tagged newsletter, launch-list).
{%- endcomment -%}

{%- liquid
  assign heading_lines = section.settings.heading | split: '|'
  assign launch_open = false
  assign launch_success = false
-%}

<section class="mh-soon" id="ComingSoon-{{ section.id }}">
  <div class="mh-soon__card">
    <div class="mh-soon__media" aria-hidden="true">
      {%- if section.settings.video != blank -%}
        {{
          section.settings.video
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            playsinline: true,
            controls: false,
            image_size: '1920x',
            class: 'mh-soon__bg'
        }}
      {%- elsif section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            class: 'mh-soon__bg',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '750, 1100, 1500, 1920, 2400',
            sizes: '100vw',
            alt: ''
        }}
      {%- else -%}
        <img
          class="mh-soon__bg"
          src="{{ 'merchouse-hero.jpg' | asset_url }}"
          alt=""
          width="1440"
          height="804"
          fetchpriority="high"
        >
      {%- endif -%}
      <div class="mh-soon__overlay"></div>
    </div>

    <div class="mh-soon__inner">
      <div class="mh-soon__copy">
        <span
          class="mh-mark"
          role="img"
          aria-label="{{ shop.name | escape }}"
          style="--mh-mark: url('{{ 'merchouse-h.png' | asset_url }}');"
        ></span>
        <h1 class="mh-soon__heading">
          {%- for line in heading_lines -%}
            {{- line | strip | escape -}}
            {%- unless forloop.last %}<br>{% endunless -%}
          {%- endfor -%}
        </h1>
      </div>

      <div class="mh-glass">
        <div class="mh-glass__head">
          <h2 class="mh-glass__title">{{ section.settings.card_title | escape }}</h2>
          {%- if section.settings.card_subtitle != blank -%}
            <p class="mh-glass__sub">{{ section.settings.card_subtitle | escape }}</p>
          {%- endif -%}
        </div>

        {%- comment -%} Placeholder sign-in: no name attributes, nothing is sent. {%- endcomment -%}
        <form class="mh-signin" data-mh-signin novalidate autocomplete="off">
          <div class="mh-field">
            <label class="mh-field__label" for="MhEmail-{{ section.id }}">Email</label>
            <input
              class="mh-field__input"
              id="MhEmail-{{ section.id }}"
              type="email"
              placeholder="you@email.com"
              autocomplete="off"
            >
          </div>
          <div class="mh-field">
            <label class="mh-field__label" for="MhPassword-{{ section.id }}">Password</label>
            <input
              class="mh-field__input"
              id="MhPassword-{{ section.id }}"
              type="password"
              placeholder="••••••••••"
              autocomplete="off"
            >
          </div>
          <a href="#" class="mh-signin__forgot" data-mh-signin-trigger>Forgot password?</a>
          <button type="submit" class="mh-btn mh-btn--green mh-btn--block">
            {{- section.settings.signin_label | escape -}}
          </button>
          <p class="mh-signin__note" data-mh-signin-note role="status" hidden>
            {{- section.settings.signin_note | escape -}}
          </p>
        </form>

        <div class="mh-divider" role="presentation"><span>or</span></div>

        {%- form 'customer', id: 'MhLaunchForm', class: 'mh-launch' -%}
          {%- if form.posted_successfully? -%}
            {%- assign launch_success = true -%}
          {%- endif -%}
          {%- if form.errors -%}
            {%- assign launch_open = true -%}
          {%- endif -%}

          {%- if launch_success -%}
            <p class="mh-launch__success" role="status" tabindex="-1" autofocus>
              {{- section.settings.launch_success | escape -}}
            </p>
          {%- else -%}
            <button
              type="button"
              class="mh-btn mh-btn--outline mh-btn--block"
              data-mh-launch-toggle
              aria-expanded="{{ launch_open }}"
              aria-controls="MhLaunchFields-{{ section.id }}"
              {% if launch_open %}
                hidden
              {% endif %}
            >
              {{- section.settings.launch_label | escape -}}
            </button>
            <div
              class="mh-launch__fields"
              id="MhLaunchFields-{{ section.id }}"
              data-mh-launch-fields
              {% unless launch_open %}
                hidden
              {% endunless %}
            >
              <input type="hidden" name="contact[tags]" value="newsletter,launch-list">
              <label class="mh-field__label" for="MhLaunchEmail-{{ section.id }}">Email for launch updates</label>
              <div class="mh-launch__row">
                <input
                  class="mh-field__input"
                  id="MhLaunchEmail-{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  autocomplete="email"
                  placeholder="you@email.com"
                  required
                  {% if form.errors %}
                    aria-invalid="true" aria-describedby="MhLaunchError-{{ section.id }}"
                  {% endif %}
                >
                <button type="submit" class="mh-btn mh-btn--green">Notify me</button>
              </div>
              {%- if form.errors -%}
                <p class="mh-launch__error" id="MhLaunchError-{{ section.id }}">
                  {{- form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email -}}
                </p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endform -%}

        {%- if section.settings.footnote != blank -%}
          <p class="mh-glass__foot">{{ section.settings.footnote | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if section.settings.show_copyright -%}
    <p class="mh-soon__legal">© {{ 'now' | date: '%Y' }} {{ shop.name | escape }} · Georgetown, TX</p>
  {%- endif -%}
</section>

<script>
  (function () {
    var root = document.getElementById('ComingSoon-{{ section.id }}');
    if (!root) return;

    var signin = root.querySelector('[data-mh-signin]');
    var note = root.querySelector('[data-mh-signin-note]');
    function showNote(e) {
      if (e) e.preventDefault();
      if (note) note.hidden = false;
    }
    if (signin) signin.addEventListener('submit', showNote);
    root.querySelectorAll('[data-mh-signin-trigger]').forEach(function (el) {
      el.addEventListener('click', showNote);
    });

    var toggle = root.querySelector('[data-mh-launch-toggle]');
    var fields = root.querySelector('[data-mh-launch-fields]');
    if (toggle && fields) {
      toggle.addEventListener('click', function () {
        fields.hidden = false;
        toggle.hidden = true;
        toggle.setAttribute('aria-expanded', 'true');
        var input = fields.querySelector('input[type="email"]');
        if (input) input.focus();
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Coming soon",
  "tag": "div",
  "class": "mh-soon-section",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video",
      "info": "Plays muted on a loop. Leave empty to use the image."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Used when no video is set. Defaults to the Merchouse hero image."
    },
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "MERCH|LIVES HERE.",
      "info": "Use | for a line break."
    },
    {
      "type": "header",
      "content": "Sign-in card (placeholder)"
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Card title",
      "default": "Sign in"
    },
    {
      "type": "text",
      "id": "card_subtitle",
      "label": "Card subtitle",
      "default": "Shop accounts open when we launch."
    },
    {
      "type": "text",
      "id": "signin_label",
      "label": "Sign in button",
      "default": "Sign In"
    },
    {
      "type": "text",
      "id": "signin_note",
      "label": "Message after Sign In is pressed",
      "default": "Accounts open at launch. Check back soon."
    },
    {
      "type": "text",
      "id": "launch_label",
      "label": "Launch updates button",
      "default": "Get launch updates"
    },
    {
      "type": "text",
      "id": "launch_success",
      "label": "Launch updates success message",
      "default": "You’re on the list. We’ll email you when we open."
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "Have a pre-order link? It works now."
    },
    {
      "type": "checkbox",
      "id": "show_copyright",
      "label": "Show copyright line",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Coming soon"
    }
  ]
}
{% endschema %}
