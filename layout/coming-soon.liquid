<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#063038">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'merchouse-h.png' | asset_url }}">
    {%- endif -%}

    <title>{{ shop.name }}{% if page_title != blank and request.page_type != 'index' %} · {{ page_title }}{% endif %}</title>
    <meta name="description" content="{{ shop.description | default: 'School, team and club merch for Georgetown, Texas. Opening soon.' | escape }}">

    {% render 'meta-tags' %}
    {%- render 'merchouse-fonts' -%}
    {{ 'merchouse.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="mh-soon-body">
    <a class="mh-skip" href="#MainContent">Skip to content</a>
    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
