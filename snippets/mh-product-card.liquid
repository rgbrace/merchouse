{%- comment -%} Merchouse product card (More From, shop grids). Params: p (product), color (optional: show that color's photo and link to it). Up to 4 color dots, then +N. {%- endcomment -%}
{%- liquid
  assign color_opt = nil
  for o in p.options_with_values
    assign on = o.name | downcase
    if on contains 'color' or on contains 'colour'
      assign color_opt = o
    endif
  endfor
  assign style_count = p.metafields.merchouse.sibling_products.value.size | default: p.metafields.custom.style_siblings.value.size | default: 0

  comment
    Hover shows the back: only for designs with a back print (merchouse.has_back_print, set by
    M Studio builds), using the back photo of the same color as the card's front ("Black front" -> "Black back").
    Other designs keep the zoom.
  endcomment
  # Card photo: the picked color's front photo (alt "{Color} front") when a color is given, else the featured photo.
  assign front = p.featured_media
  assign href = p.url
  if color != blank
    assign want = color | append: ' front' | downcase
    for m in p.media
      assign ma = m.alt | downcase
      if ma == want
        assign front = m
        break
      endif
    endfor
    for v in p.variants
      if v.options contains color
        assign href = v.url
        break
      endif
    endfor
  endif

  assign back = nil
  if p.metafields.merchouse.has_back_print.value == true and front
    assign back_alt = front.alt | replace: ' front', ' back'
    for m in p.media
      if m.alt == back_alt and m.id != front.id
        assign back = m
        break
      endif
    endfor
  endif
-%}
<a class="mh-card{% if back %} has-back{% endif %}" href="{{ href }}">
  <span class="mh-card__media">
    {%- if front -%}
      {{ front | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 400, 600, 800', sizes: '(min-width: 990px) 380px, 80vw', alt: p.title }}
      {%- if back -%}
        {{ back | image_url: width: 800 | image_tag: class: 'mh-card__back', loading: 'lazy', widths: '300, 400, 600, 800', sizes: '(min-width: 990px) 380px, 80vw', alt: '' }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'mh-card__placeholder' }}
    {%- endif -%}
  </span>
  {%- if color_opt -%}
    <span class="mh-card__dots" aria-label="{{ color_opt.values.size }} colors">
      {%- for value in color_opt.values limit: 4 -%}
        {%- assign vlow = value | downcase -%}
        <span class="mh-card__dot{% if vlow contains 'heather' or vlow contains 'tri-blend' %} is-heather{% endif %}" style="--swatch: {% render 'mh-swatch-color', value: value %};" title="{{ value | escape }}"></span>
      {%- endfor -%}
      {%- if color_opt.values.size > 4 -%}<span class="mh-card__more">+{{ color_opt.values.size | minus: 4 }}</span>{%- endif -%}
    </span>
  {%- endif -%}
  <span class="mh-card__title">{{ p.title | split: ' – ' | first | escape }}</span>
  <span class="mh-card__price">{{ p.price | money_without_trailing_zeros }}</span>
  {%- if style_count > 1 -%}
    <span class="mh-card__styles">Available in {{ style_count }} styles</span>
  {%- endif -%}
</a>
