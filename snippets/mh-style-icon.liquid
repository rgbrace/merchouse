{%- comment -%}
  Merchouse style icons (from Figma "Style Item" component).
  Usage: {% render 'mh-style-icon', style: 'Hooded' %}
  Matches loosely: zip → Zip Hoodie, hood → Hooded, long → Long Sleeve,
  perform → Performance, sweat/crew → Sweatshirt, polo, hat/cap, everything else → T-Shirt.
{%- endcomment -%}
{%- liquid
  assign s = style | downcase
  if s contains 'zip'
    assign key = 'zip'
  elsif s contains 'hood'
    assign key = 'hooded'
  elsif s contains 'long'
    assign key = 'long'
  elsif s contains 'perform'
    assign key = 'performance'
  elsif s contains 'sweat' or s contains 'crew'
    assign key = 'sweatshirt'
  elsif s contains 'polo'
    assign key = 'polo'
  elsif s contains 'hat' or s contains 'cap' or s contains 'beanie' or s contains 'head'
    assign key = 'hat'
  else
    assign key = 'tee'
  endif
-%}
